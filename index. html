    }

    .job-icon {
      width: 48px;
      height: 48px;
      background: #fff2e8;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 16px;
      flex-shrink: 0;
    }

    .job-icon i {
      font-size: 22px;
      color: #fe6a00;
    }

    .job-details {
      flex: 1;
      min-width: 0;
    }

    .job-title {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 5px;
    }

    .job-title h3 {
      font-size: 1rem;
      font-weight: 600;
      color: #1e293b;
      letter-spacing: -0.2px;
    }

    .job-tag {
      background: #eaf6ef;
      color: #0e7b3e;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 40px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      border: 1px solid #b8e6cc;
    }

    .job-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
      font-size: 0.78rem;
      color: #5a6b7e;
    }

    .job-meta span {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .job-meta i {
      font-size: 11px;
      color: #99a9bb;
      width: 14px;
    }

    .salary {
