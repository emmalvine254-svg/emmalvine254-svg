        height: 42px;
        margin-right: 12px;
      }
      .job-icon i {
        font-size: 18px;
      }
      .job-title h3 {
        font-size: 0.92rem;
      }
      .search-wrapper button span {
        display: none;
      }
      .search-wrapper button {
