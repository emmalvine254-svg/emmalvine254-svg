      font-weight: 600;
      color: #fe6a00;
      display: flex;
      align-items: center;
      gap: 6px;
      background: #fff4ec;
      padding: 8px 16px;
      border-radius: 40px;
      transition: background 0.15s;
      cursor: default;
      letter-spacing: 0.2px;
    }

    .view-all i {
      font-size: 11px;
    }

    .view-all:hover {
      background: #ffe8d9;
