      color: #cbd5e1;
      font-size: 14px;
      margin-left: 8px;
      transition: transform 0.15s;
    }

    .job-item:hover .arrow-icon {
      color: #fe6a00;
      transform: translateX(3px);
    }

    /* footer — jumia supermarket jobs branding */
    .menu-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 24px 20px 24px;
      background: #ffffff;
      border-top: 1px solid #edf2f7;
      margin-top: 4px;
    }

