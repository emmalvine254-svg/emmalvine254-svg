      align-items: center;
      padding: 16px 16px 16px 18px;
      border-radius: 18px;
      transition: all 0.15s;
      cursor: default;
      background: white;
      border: 1px solid transparent;
      margin-bottom: 2px;
    }

    .job-item:hover {
      background: #fefaf6;
      border-color: #ffe4d0;
